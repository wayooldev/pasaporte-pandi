# Neon PostgreSQL (optional locally — mock fallback without it)
DATABASE_URL=

# Clerk Auth (required for /admin)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# WhatsApp handoff (E.164 México, optional)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Resend — email de constancia al asesor (required in production for advisor notify)
RESEND_API_KEY=
# From must be a verified domain in Resend (dev can use onboarding@resend.dev)
RESEND_FROM_EMAIL=Pasaporte Pandi <hola@pasaportepandi.com>
# Inbox that receives quote requests (defaults to brand contact email)
ADVISOR_NOTIFY_EMAIL=hola@pasaportepandi.com


# Clerk routing (optional; defaults used in app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin
